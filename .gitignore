# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Temporary and task history files
native_host/tasks/*.json
!native_host/tasks/.gitkeep
native_host/tasks/*.tmp
native_host/tasks/*_cookies.txt
*cookies*.txt
# External helper binaries and tools
bin/
temp_setup/
native_host/yt-dlp.exe
native_host/ffmpeg.exe
native_host/ffprobe.exe
native_host/AtomicParsley.exe

# Machine-specific native messaging host manifest (generated by install_host.bat)
native_host/com.ytdlp.downloader.json

# Download outputs (keep directory structure)
output/*
!output/.gitkeep

# OS and IDE files
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Rust build artifacts
target/
Cargo.lock

# AI Assistant documentation
[Gg][Ee][Mm][Ii][Nn][Ii].[Mm][Dd]
[Cc][Ll][Aa][Uu][Dd][Ee].[Mm][Dd]

